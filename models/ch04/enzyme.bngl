# Phosphorylation by a kinase, written two ways: as an explicit
# binding-catalysis mechanism (kinase E, substrate S) and with a
# Michaelis-Menten rate law (kinase E2, substrate S2). The two pairs are kept
# separate so that each mechanism has its own pool of enzyme.
begin model
begin parameters
  E0    0.01    # kinase (uM)
  S0    1       # substrate (uM)
  kon   10      # kinase-substrate binding (1/uM/min)
  koff  1       # unbinding (1/min)
  kcat  1       # catalysis (1/min)
  Km    (koff+kcat)/kon   # Michaelis constant (uM)
end parameters
begin molecule types
  E(s)
  S(e,Y~0~P)
  E2()
  S2(Y~0~P)
end molecule types
begin seed species
  E(s)          E0
  S(e,Y~0)      S0
  E2()          E0
  S2(Y~0)       S0
end seed species
begin observables
  Molecules Sp_explicit  S(Y~P)
  Molecules Sp_MM        S2(Y~P)
end observables
begin reaction rules
  # explicit mechanism
  ESbind: E(s) + S(e,Y~0) <-> E(s!1).S(e!1,Y~0)  kon, koff
  EScat:  E(s!1).S(e!1,Y~0) -> E(s) + S(e,Y~P)    kcat
  # Michaelis-Menten rate law (enzyme is not consumed)
  MMcat:  E2() + S2(Y~0) -> E2() + S2(Y~P)        MM(kcat,Km)
end reaction rules
end model
generate_network({overwrite=>1})
simulate({method=>"ode",t_end=>200,n_steps=>200})
