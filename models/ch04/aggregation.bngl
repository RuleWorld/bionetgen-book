# A bivalent ligand and a bivalent receptor form chains and rings. The rule
# Close joins the free ends of a chain of any length into a ring. Network
# generation is capped with max_agg, the largest complex allowed (in molecules).
begin model
begin parameters
  L0    1
  R0    1
  kon   1
  koff  0.1
  kring 10
end parameters
begin molecule types
  L(r,r)
  R(l,l)
end molecule types
begin seed species
  L(r,r)  L0
  R(l,l)  R0
end seed species
begin observables
  # Rings of two and four molecules
  Species Ring2  L(r!1,r!2).R(l!1,l!2)
  Species Ring4  L(r!1,r!2).R(l!2,l!3).L(r!3,r!4).R(l!4,l!1)
end observables
begin reaction rules
  Bind:  L(r) + R(l) <-> L(r!1).R(l!1)                        kon, koff
  # A free L site and a free R site in the same complex bind, closing a ring;
  # the reverse opens a ring without splitting the complex
  Close: L(r).R(l) <-> L(r!1).R(l!1)                         kring, koff
end reaction rules
end model
generate_network({overwrite=>1,max_agg=>4})
