# Deliberately inconsistent passive-binding model for teaching.
# Binding B after A is enhanced; binding A after B is not.
# Concentrations: uM; time: min. The cycle has no specified energy source.
begin model
begin parameters
  R0      1
  L0      1
  kon     1
  koff    0.1
  boost   10
end parameters
begin molecule types
  R(a,b)
  L(r)
end molecule types
begin seed species
  R(a,b) R0
  L(r)   L0
end seed species
begin observables
  Molecules R00     R(a,b)
  Molecules R10     R(a!+,b)
  Molecules R01     R(a,b!+)
  Molecules R11     R(a!+,b!+)
  Molecules Rtotal  R()
  Molecules Lfree   L(r)
  Molecules Ltotal  L()
end observables
begin reaction rules
  A_first:  R(a,b) + L(r) <-> R(a!1,b).L(r!1)       kon, koff
  A_second: R(a,b!+) + L(r) <-> R(a!1,b!+).L(r!1)   kon, koff
  B_first:  R(a,b) + L(r) <-> R(a,b!1).L(r!1)       kon, koff
  B_second: R(a!+,b) + L(r) <-> R(a!+,b!1).L(r!1)   boost*kon, koff
end reaction rules
end model
generate_network({overwrite=>1})
simulate({method=>"ode",t_end=>300,n_steps=>300})
